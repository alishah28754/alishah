# Server
PORT=8000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ktex_db

# Admin panel login (email + password, checked against MySQL, separate
# from the Firebase login the Flutter app uses). Any long random string --
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Firebase Admin SDK (used to verify ID tokens from the Flutter app's
# Google / email-password login). Get these from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=ktex-36211
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ktex-36211.iam.gserviceaccount.com
