# Server
PORT=8000
NODE_ENV=production

# ============================================
# LOCAL DATABASE (Development) - not used on Railway, keep as reference
# ============================================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=ktex_db

# ============================================
# PRODUCTION DATABASE (Railway MySQL)
# ============================================
PROD_DB_HOST=${{MySQL.MYSQLHOST}}
PROD_DB_PORT=${{MySQL.MYSQLPORT}}
PROD_DB_USER=${{MySQL.MYSQLUSER}}
PROD_DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
PROD_DB_NAME=${{MySQL.MYSQLDATABASE}}

# Admin panel login (email + password, checked against MySQL, separate
# from the Firebase login the Flutter app uses).
JWT_SECRET=change_this_to_a_long_random_string

# Firebase Admin SDK
FIREBASE_PROJECT_ID=ktex-36211
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ktex-36211.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# PayFast (Pakistan) - Hosted Checkout
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_NAME=KTEX Store
PAYFAST_SECURED_KEY=your_secured_key
PAYFAST_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_CHECKOUT_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_MODE=sandbox

# Where PayFast redirects the customer's browser after payment
PAYFAST_SUCCESS_URL=https://ktex.up.railway.app/api/payments/payfast/success
PAYFAST_FAILURE_URL=https://ktex.up.railway.app/api/payments/payfast/failure

# Server-to-server callback PayFast calls to confirm the transaction
PAYFAST_CALLBACK_URL=https://ktex.up.railway.app/api/payments/payfast/callback

# Uploads
UPLOAD_MAX_SIZE_MB=5

# CORS
CORS_ORIGIN=*

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
