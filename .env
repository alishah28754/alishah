# Server
PORT=8000
NODE_ENV=production

# ============================================
# LOCAL DATABASE (Development) - not used on Railway, keep as reference
# ============================================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=ktex_db

# ============================================
# PRODUCTION DATABASE (Railway MySQL)
# ============================================
PROD_DB_HOST=${{MySQL.MYSQLHOST}}
PROD_DB_PORT=${{MySQL.MYSQLPORT}}
PROD_DB_USER=${{MySQL.MYSQLUSER}}
PROD_DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
PROD_DB_NAME=${{MySQL.MYSQLDATABASE}}

# Admin panel login (email + password, checked against MySQL, separate
# from the Firebase login the Flutter app uses).
JWT_SECRET=change_this_to_a_long_random_string

