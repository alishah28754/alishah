{
  "name": "ktex-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MySQL backend API for the KTEX Flutter e-commerce app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node database/init.js",
    "db:fix-ids": "mysql -u root -p ktex_db < database/migration_fix_product_ids.sql",
    "db:set-admin": "node database/set-admin-password.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.5",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
