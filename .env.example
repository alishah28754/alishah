# Server
PORT=8000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ktex_db
DB_CONNECTION_LIMIT=3

# JWT Secret (for admin panel)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# PayFast (secondary priority)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_NAME=KTEX Store
PAYFAST_SECURED_KEY=your_secured_key
PAYFAST_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_CHECKOUT_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_SUCCESS_URL=http://localhost:8000/api/payments/payfast/success
PAYFAST_FAILURE_URL=http://localhost:8000/api/payments/payfast/failure
PAYFAST_CALLBACK_URL=http://localhost:8000/api/payments/payfast/callback

# Cloudinary (secondary priority)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGIN=*

# Uploads
UPLOAD_MAX_SIZE_MB=5