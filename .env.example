# Server
PORT=8000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ktex_db

# Admin panel login (email + password, checked against MySQL, separate
# from the Firebase login the Flutter app uses). Any long random string --
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Firebase Admin SDK (used to verify ID tokens from the Flutter app's
# Google / email-password login). Get these from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON, keep the \n escape sequences as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# PayFast (Pakistan) - Hosted Checkout
# Get these from your PayFast merchant dashboard (gopayfast.com)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_NAME=KTEX Store
PAYFAST_SECURED_KEY=your_secured_key
# Confirm the exact token / hosted-checkout URLs with PayFast - sandbox vs live differ
PAYFAST_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_CHECKOUT_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_MODE=sandbox
# Where PayFast redirects the customer's browser after payment
PAYFAST_SUCCESS_URL=http://localhost:8000/api/payments/payfast/success
PAYFAST_FAILURE_URL=http://localhost:8000/api/payments/payfast/failure
# Server-to-server callback PayFast calls to confirm the transaction
PAYFAST_CALLBACK_URL=http://localhost:8000/api/payments/payfast/callback

# Uploads
UPLOAD_MAX_SIZE_MB=5

# CORS - comma separated list of allowed origins (Flutter web / admin panel URLs)
# Use * to allow all (fine for local dev, mobile apps don't send Origin header)
CORS_ORIGIN=*

# Cloudinary (image storage -- required so uploaded images survive restarts
# on hosts with ephemeral disk, like Render/Vercel). Free account:
# 1. Sign up at https://cloudinary.com
# 2. Dashboard -> copy Cloud name, API Key, API Secret below
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
